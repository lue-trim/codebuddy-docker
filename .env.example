# 先 cp .env.example .env 再按需修改

# 固定版本，升级时改成新版本号后重新 build
CODEBUDDY_VERSION=2.184.0

# 容器内监听端口；容器外映射端口与之相同
PORT=7890
# 默认只监听 127.0.0.1；有 TLS + 鉴权反代时可改成 0.0.0.0
BIND_IP=127.0.0.1

TZ=Asia/Shanghai

# 主 Agent 与默认权限模式。远程场景建议 cli + default（可在浏览器里逐条批准）
AGENT=cli
PERMISSION_MODE=default
# 反代挂在子路径时才填，例如 /codebuddy/
BASE_PATH=

# 必须保持 password；none 只适合隔离内网或 CI
CODEBUDDY_GATEWAY_AUTH=password
# 留空 = 首次启动自动生成随机密码并写进 settings.json；也可手动设置强密码
CODEBUDDY_GATEWAY_PASSWORD=

# 用反代域名访问时填真实 origin，逗号分隔，例如 https://codebuddy.example.com
CODEBUDDY_CODE_CORS_ORIGINS=

# 与宿主机项目目录的 uid/gid 对齐；id -u / id -g 查看
PUID=1000
PGID=1000

# 挂载进容器的项目根目录
WORKSPACE_DIR=./workspace
CODEBUDDY_DIR=./codebuddy

# 额外 CLI 参数，例如：EXTRA_ARGS=--add-dir /workspace/another --model xxx
EXTRA_ARGS=
